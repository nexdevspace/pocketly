# Public browser configuration. RLS, not these values, protects user data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional legacy fallback for older Supabase projects. Prefer the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Origin used when creating Auth email callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
